<!DOCTYPE html>
<html lang="pt-BR">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    Relatórios da Plataforma
  </title>

  <%- include('../../partials/head.ejs') %>

  <style>

    .dashboard-page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 32px 20px;
    }

    .dashboard-header {
      margin-bottom: 32px;
    }

    .dashboard-title {
      font-size: 36px;
      font-weight: bold;
    }

    .dashboard-subtitle {
      opacity: .7;
      margin-top: 8px;
    }

    .dashboard-grid {
      display: grid;
      grid-template-columns: repeat(
        auto-fit,
        minmax(260px, 1fr)
      );
      gap: 20px;
      margin-bottom: 32px;
    }

    .stat-card {
      padding: 24px;
      border-radius: 18px;
      background: var(--card-bg, #fff);
      border: 1px solid #e5e7eb;
    }

    .stat-title {
      font-size: 14px;
      opacity: .7;
      margin-bottom: 10px;
    }

    .stat-value {
      font-size: 34px;
      font-weight: bold;
    }

    .dashboard-section {
      margin-top: 40px;
    }

    .section-title {
      font-size: 24px;
      margin-bottom: 20px;
      font-weight: bold;
    }

    .table-wrapper {
      overflow-x: auto;
      border-radius: 16px;
      border: 1px solid #e5e7eb;
      background: white;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th {
      text-align: left;
      padding: 16px;
      font-size: 14px;
      border-bottom: 1px solid #e5e7eb;
      background: #f9fafb;
    }

    td {
      padding: 16px;
      border-bottom: 1px solid #f3f4f6;
    }

    tr:last-child td {
      border-bottom: none;
    }

    .skill-level-bar {
      width: 100%;
      height: 10px;
      background: #e5e7eb;
      border-radius: 999px;
      overflow: hidden;
    }

    .skill-level-fill {
      height: 100%;
      background: #10b981;
      border-radius: 999px;
    }

    .empty-text {
      opacity: .7;
      padding: 20px;
    }

  </style>

</head>

<body>

  <%- include('../../partials/header.ejs') %>

  <main class="dashboard-page">

    <!-- HEADER -->

    <div class="dashboard-header">

      <h1 class="dashboard-title">
        Relatórios da Plataforma
      </h1>

      <p class="dashboard-subtitle">
        Estatísticas gerais sobre Alunos,
        skills e receitas.
      </p>

    </div>

    <!-- STATS -->

    <div class="dashboard-grid">

      <div class="stat-card">

        <div class="stat-title">
          Total de Receitas
        </div>

        <div class="stat-value">
          <%= report.recipes.total %>
        </div>

      </div>

      <div class="stat-card">

        <div class="stat-title">
          Total de Skills
        </div>

        <div class="stat-value">
          <%= report.skills.length %>
        </div>

      </div>

      <div class="stat-card">

        <div class="stat-title">
          Categorias Ativas
        </div>

        <div class="stat-value">
          <%= report.recipes.byCategory.length %>
        </div>

      </div>

    </div>

    <!-- SKILLS -->

    <section class="dashboard-section">

      <h2 class="section-title">
        Skills dos Alunos
      </h2>

      <div class="table-wrapper">

        <% if(report.skills.length) { %>

          <table>

            <thead>

              <tr>

                <th>Skill</th>
                <th>Alunos</th>
                <th>Média</th>
                <th>Perícia</th>
                <th>Nível Médio</th>

              </tr>

            </thead>

            <tbody>

              <% report.skills.forEach(skill => { %>

                <tr>

                  <td>
                    <strong>
                      <%= skill.name %>
                    </strong>

                    <br>

                    <small>
                      <%= skill.slug %>
                    </small>
                  </td>

                  <td>
                    <%= skill.users_count %>
                  </td>

                  <td>
                    <%= skill.average_level %> / 10
                  </td>

                  <td>
                    <%= skill.mastery_users_count %>
                  </td>

                  <td style="width: 240px;">

                    <div class="skill-level-bar">
                      <div
                        class="skill-level-fill"
                        style="width: <%= skill.average_level * 10 %>%;"
                      ></div>

                    </div>

                  </td>

                </tr>

              <% }) %>

            </tbody>

          </table>

        <% } else { %>

          <div class="empty-text">
            Nenhuma skill encontrada.
          </div>

        <% } %>

      </div>

    </section>

    <!-- RECIPES BY CATEGORY -->

    <section class="dashboard-section">

      <h2 class="section-title">
        Receitas por Categoria
      </h2>

      <div class="table-wrapper">

        <% if(report.recipes.byCategory.length) { %>

          <table>

            <thead>

              <tr>

                <th>Categoria</th>
                <th>Slug</th>
                <th>Quantidade</th>

              </tr>

            </thead>

            <tbody>

              <% report.recipes.byCategory.forEach(category => { %>

                <tr>

                  <td>
                    <strong>
                      <%= category.name %>
                    </strong>
                  </td>

                  <td>
                    <%= category.slug %>
                  </td>

                  <td>
                    <%= category.recipes_count %>
                  </td>

                </tr>

              <% }) %>

            </tbody>

          </table>

        <% } else { %>

          <div class="empty-text">
            Nenhuma categoria encontrada.
          </div>

        <% } %>

      </div>

    </section>

  </main>

</body>
</html>