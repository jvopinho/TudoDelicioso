<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head') %>
  <link rel="stylesheet" href="/styles/create-recipe.css">
  
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Cookery Book</title>
</head>
<body>
  <%- include('../../partials/header') %>  
  <main class="create-container">
    <div class="create-card">
      
      <h1 class="create-title">
        CRIAR NOVA RECEITA
      </h1>
      
      <form>
        
        <div class="form-group">
          <label class="form-label required">
            Título da Receita
          </label>
          
          <input
          type="text"
          class="form-input"
          placeholder="Ex: Lasanha de Frango Cremosa"
          id="recipe-title"
          >
        </div>
        
        <div class="form-group">
          <label class="form-label">
            Descrição
          </label>
          
          <textarea
          class="form-textarea"
          placeholder="Descreva a receita..."
          id="recipe-description"
          style="min-height: 80px !important;"
          ></textarea>
        </div>
        
        <div class="form-group">
          <label class="form-label required">
            Categorias
          </label>
          
          <div class="multi-select">

            <% categories.forEach(category => { %>
              <label class="multi-option">
                <input type="checkbox" name="categories" value="<%= category.id %>">
                <span><%= category.name %></span>
              </label>
            <% }) %>
          </div>
        </div>
        
        <div class="form-group">
          
          <label class="form-label">
            Upload da Imagem
          </label>
          
          <label class="upload-box" id="upload-box">
            
            <input
            type="file"
            class="upload-input"
            accept="image/*"
            id="recipe-image"
            >
            
            <img
            src=""
            alt="Preview"
            class="upload-preview"
            id="upload-preview"
            >
            
            <div class="upload-placeholder" id="upload-placeholder">
              
              <div class="upload-icon">📷</div>
              
              <div class="upload-text">
                Clique para enviar uma imagem
              </div>
              
              <div class="upload-subtext">
                PNG, JPG ou WEBP
              </div>
              
            </div>
            
          </label>
          
        </div>
        
        <div class="form-group">
          <label class="form-label required">
            Ingredientes
          </label>
          
          <div class="ingredients-list" id="ingredients-list">
            
            <div class="ingredient-row">
              <input
              type="text"
              name="ingredient"
              class="form-input"
              placeholder="Ingrediente"
              data-ingredient
              >
            </div>
            
          </div>
          
          <br>
          
          <button type="button" class="add-btn">
            + Adicionar Ingrediente
          </button>
        </div>
        
        <div class="form-group">
          <label class="form-label required">
            Modo de Preparo
          </label>
          
          <textarea
          class="form-textarea"
          placeholder="Descreva passo a passo..."
          id="preparation-steps"
          ></textarea>
        </div>
        
        <div class="form-group">
          
          <label class="form-label">
            Autores da Receita
          </label>
          
          <div class="authors-box">
            
            <!-- Autores selecionados -->
            <div class="selected-authors" id="selected-authors"></div>
            
            <!-- Input -->
            <input
            type="text"
            class="authors-input"
            id="authors-input"
            placeholder="Digite o nome do autor..."
            autocomplete="off"
            >
            
            <!-- Sugestões -->
            <div class="authors-dropdown" id="authors-dropdown"></div>
            
          </div>
          
        </div>
        
        <div class="form-group">
          <label class="form-label">
            Dicas Extras
          </label>
          
          <textarea
          class="form-textarea"
          placeholder="Ex: Sirva com queijo parmesão..."
          id="extra-tips"
          ></textarea>
        </div>
        
        <div class="actions">
          <button class="submit-btn" id="submit-btn">
            Publicar Receita
          </button>
        </div>
        
      </form>
      
    </div>
  </main>
  
  <script src="/js/create-recipe.js"></script>

  <div style="display: none;" id="users-data">
    <%- JSON.stringify(users) %>
  </div>

  <script>
    users = JSON.parse(document.getElementById('users-data').textContent)

    renderSelectedUsers()

    const recipeTitleInput = document.getElementById('recipe-title')
    const recipeDescriptionInput = document.getElementById('recipe-description')
    
    const ingredientsList = document.getElementById('ingredients-list')
    const addIngredientBtn = document.querySelector('.add-btn')
    
    const preparationStepsTextarea = document.getElementById('preparation-steps')
    const extraTipsTextarea = document.getElementById('extra-tips')
    
    const imageInput = document.getElementById('recipe-image')
    const preview = document.getElementById('upload-preview')
    const placeholder = document.getElementById('upload-placeholder')
    
    const submitButton = document.getElementById('submit-btn')
    
    let file
    
    imageInput.addEventListener('change', (event) => {
      file = event.target.files[0]
      
      if (!file) return
      
      const reader = new FileReader()
      
      reader.onload = (e) => {
        preview.src = e.target.result
        preview.style.display = 'block'
        
        placeholder.style.display = 'none'
      }
      
      reader.readAsDataURL(file)
    })

    addIngredientBtn.addEventListener(
      'click',
      () => {

        console.log('Adicionando ingrediente');

        const row = document.createElement('div')

        row.classList.add('ingredient-row')

        row.innerHTML = `
          <input
            type="text"
            name="ingredient"
            class="form-input"
            placeholder="Ingrediente"
            data-ingredient
          >
        `

        ingredientsList.appendChild(row)

      }
    )
    
    submitButton.addEventListener('click', async(event) => {
      event.preventDefault()
      const title = recipeTitleInput.value
      const description = recipeDescriptionInput.value ?? null
      const categoryCheckboxes = document.querySelectorAll('input[name="categories"]:checked')
      const categories = Array.from(categoryCheckboxes).map(cb => cb.value)
      const preparationSteps = preparationStepsTextarea.value.split('\n').filter(line => line.trim() !== '')
      const ingredients = Array.from(document.querySelectorAll('input[name="ingredient"]')).map(input => input.value).filter(value => value.trim() !== '')
      const extraTips = extraTipsTextarea.value
      
      if(!title) {
        alert('O título da receita é obrigatório!')
        return
      }
      
      if(!categories.length) {
        alert('Selecione pelo menos uma categoria!')
        return
      }
      
      if(!preparationSteps.length) {
        alert('O modo de preparo é obrigatório!')
        return
      }
      
      if(!ingredients.length) {
        alert('Adicione pelo menos um ingrediente!')
        return
      }
      
      console.table({selectedUsers, title, description, categories, preparationSteps, extraTips, ingredients, file});
      
      const authToken = getCookie('session_token')
      
      console.log(authToken)
      
      const response = await axios.post('/api/recipes', {
        title,
        description,
        category_ids: categories,
        author_ids: selectedUsers.map(a => parseInt(a.id)),
        instructions: preparationSteps,
        extraTips,
        ingredients,
        tips: extraTips,
        
        // ! Para implementar
        preparation_time: 45,
        difficulty: 'MEDIUM',
        servings: 4,
        external_url: null,
      }, {
        headers: {
          'Authorization': `${authToken}`
        }
      }).catch(err => err.response)

      if(response.status !== 201) {
        alert(response.data?.message || 'Erro ao publicar receita. Tente novamente.')
        return
      }
      
      const data = response.data
      if(file) {
        const formData = new FormData()
        formData.append('thumbnail', file)
        
        console.log(formData);
        
        await axios.post(`/api/recipes/${data.id}/upload`, formData, {
          headers: {
            'Authorization': `${authToken}`,
            'Content-Type': 'multipart/form-data',
          }
        })
      }
      
      alert('Receita publicada com sucesso!')
    })
  </script>
</body>
</html>