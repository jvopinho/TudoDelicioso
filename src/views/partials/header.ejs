<header>
  <div class="top-bar">
    <nav class="nav">

      <div class="nav-item">
        <span>Test</span>

        <div class="dropdown">
          <div>Appetizer</div>
          <div>Breakfast</div>
          <div>Bakery</div>
          <div>Casserole</div>
          <div>Cookies</div>
        </div>
      </div>

      <div class="nav-item">
        <% if (user) { %>
          <span>Area do Usuário</span>
          
          <div class="dropdown">
            <div>
              <a href="/recipes/create">Nova Receita</a>
            </div>

            <% if (user.role == 'ADMIN') { %>
              <div>
                <a href="/admin/users">Gerenciar Usuários</a>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <span>
            <a href="/login">Login</a>
          </span>
        <% } %>
      </div>
    </nav>
  </div>

  <div class="header-main">

    <div class="logo-area">
      <a href="/">
        <img src="/images/tudo-delicioso.svg" alt="Logo">
      </a>
    </div>

    <div class="search-box">
      <input type="text" />
      <span class="search-icon">🔍</span>
    </div>

  </div>

  <div class="zigzag"></div>
</header>