<header>
  <div class="top-bar">
    <nav class="nav">
        <div class="nav-item">
          <% if (user) { %>
            <span>Area do Usuário</span>
            
            <div class="dropdown">
              <div>
                <a href="/recipes/create">Nova Receita</a>
              </div>
              
              <div>
                <a href="/profile/recipes">Minhas Receitas</a>
              </div>
            </div>
            <% } else { %>
              <span>
                <a href="/login">Login</a>
              </span>
              <% } %>
            </div>

            <div class="nav-item">
              <% if (user && user.role == 'ADMIN') { %>
                <span>Area do Administrador</span>
                
