                  </div>
                  
                  <div>
                    <a href="/admin/recipes">Gerenciar Receitas</a>
                  </div>
                  
                  <div>
                    <a href="/admin/categories">Gerenciar Categorias</a>
                  </div>
                  
                  <div>
                    <a href="/admin/skills">Gerenciar Habilidades</a>
                  </div>
                </div>
              <% } %>
            </div>
          </nav>
        </div>
        
        <div class="header-main">
          
          <div class="logo-area">
            <a href="/">
              <img src="/images/tudo-delicioso.svg" alt="Logo">
            </a>
          </div>
          
          <!-- <div class="search-box">
            <input type="text" />
            <span class="search-icon">🔍</span>
          </div> -->
          
