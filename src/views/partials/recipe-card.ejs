<div class="recipe-card">
  <div class="recipe-header">
    <div class="date-badge">
      <strong>15</strong>
      <span>OCT</span>
    </div>
    
    <div>
      <h3 class="recipe-title">
        <%= recipe.title %> <%= recipe.id %>
      </h3>
      
      <p class="recipe-meta">
        by Admin | 0 comments
      </p>
    </div>
  </div>
  
  <div class="recipe-content">
    
    <img
    src="<%= recipe.thumbnail ? `/thumbnails/${recipe.thumbnail}` : '#' %>"
    alt="Recipe"
    />
    
    <div>
      <p>
        <%= recipe.description %>
      </p>
      
      <button class="more-btn">More</button>
    </div>
  </div>
</div>