<div class="recipe-card">
  <div class="recipe-header">
    <div class="date-badge">
      <strong>
        <%= new Date(recipe.createdAt).getDate() %>
      </strong>
      <span><%= new Date(recipe.createdAt).toLocaleString('pt-BR', { month: 'short' }).toUpperCase() %></span>
    </div>
    
    <div>
      <h3 class="recipe-title">
        <a href="/recipes/<%= recipe.id %>"><%= recipe.title %></a>
      </h3>
      
      <p class="recipe-meta">
        <% if(recipe.prepTime) { %>
          <span>⏱ <%= recipe.prepTime %> min</span>
        <% } %>
        
        <% if(recipe.difficulty == 'EASY') { %>
          <span style="background-color: rgba(0, 255, 34, 0.6); color: rgb(0, 122, 10);"> 👨‍🍳 <%= recipe.difficulty %> </span>
        <% } else if(recipe.difficulty == 'MEDIUM') { %>
          <span style="background-color: rgba(255, 230, 0, 0.6); color: rgb(122, 110, 0);"> 👨‍🍳👨‍🍳 <%= recipe.difficulty %></span>
        <% } else { %>
          <span style="background-color: rgba(255, 0, 0, 0.6); color: rgb(122, 0, 0);"> 👨‍🍳👨‍🍳👨‍🍳 <%= recipe.difficulty %></span>
        <% } %>
      </p>
    </div>
  </div>
  
  <div class="recipe-content">
    
    <img
    src="<%= recipe.thumbnail ? `/thumbnails/${recipe.thumbnail}` : '#' %>"
    alt=""
    />
    
    <div>
      <p>
        <%= recipe.description %>
      </p>
      
      <button class="more-btn" onclick="window.location.href = '/recipes/<%= recipe.id %>'">Ver Receita</button>
      
      <% try { %>
        <% if(moreActions) { %>
          <button class="more-btn" style="background-color: #7ba4b8;" onclick="window.location.href = '/recipes/<%= recipe.id %>/edit'">Editar</button>
          <button class="more-btn" onclick="deleteRecipe('<%= recipe.id %>')">Deletar</button>
        <% } %>
      <% } catch(_) {} %>
    </div>
  </div>
</div>